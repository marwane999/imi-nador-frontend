# Frontend Environment Variables
# Copy this file to .env.local and fill in values

# Public URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Facebook Page ID
NEXT_PUBLIC_FACEBOOK_PAGE_ID=Imi.nador

# WhatsApp (country code without +, number without spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=212666611390
NEXT_PUBLIC_WHATSAPP_MESSAGE=مرحباً، أريد معلومات عن دوراتكم

# Contact Info
NEXT_PUBLIC_CONTACT_EMAIL=contact@iminador.com
NEXT_PUBLIC_CONTACT_PHONE=0536-33-07-07
